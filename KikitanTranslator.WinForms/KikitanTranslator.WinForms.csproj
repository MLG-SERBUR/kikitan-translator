<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <AssemblyName>KikitanTranslator.WinForms</AssemblyName>
        <RootNamespace>KikitanTranslator.WinForms</RootNamespace>
        <Version>2.1.0</Version>
        <ApplicationIcon>..\KikitanTranslator.Photino\Resources\wwwroot\kikitan_logo.ico</ApplicationIcon>
        <!-- FORK (feed-overlay): native WinForms host. No webview/WebView2. -->
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="OscCore" Version="1.0.5" />
      <PackageReference Include="Serilog" Version="4.3.1" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="Velopack" Version="1.2.161" />
      <PackageReference Include="VRChat.OSCQuery" Version="0.0.7" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\KikitanTranslator.Base\KikitanTranslator.Base.csproj" />
      <ProjectReference Include="..\KikitanTranslator.Resources\KikitanTranslator.Resources.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Silero VAD model, shared with the upstream Photino host. -->
        <Content Include="..\KikitanTranslator.Photino\Resources\wwwroot\silero_vad.onnx">
            <Link>silero_vad.onnx</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- FORK (feed-overlay): build the overlay and stage it next to this exe,
         since AppEngine launches KikitanTranslator.Overlay.exe from the app dir. -->
    <Target Name="BuildAndStageOverlay" AfterTargets="Build">
        <!-- Restore first: the overlay is built via a raw MSBuild task (not a
             ProjectReference), so a plain `dotnet build` on a fresh checkout
             would otherwise fail with NETSDK1004. -->
        <MSBuild Projects="..\KikitanTranslator.Overlay\KikitanTranslator.Overlay.csproj"
                 Properties="Configuration=$(Configuration);EnableWindowsTargeting=true"
                 RemoveProperties="RuntimeIdentifier"
                 Targets="Restore" />
        <MSBuild Projects="..\KikitanTranslator.Overlay\KikitanTranslator.Overlay.csproj"
                 Properties="Configuration=$(Configuration);EnableWindowsTargeting=true"
                 RemoveProperties="RuntimeIdentifier"
                 Targets="Build" />
        <ItemGroup>
            <OverlayFiles Include="..\KikitanTranslator.Overlay\bin\$(Configuration)\$(TargetFramework)\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(OverlayFiles)"
              DestinationFiles="@(OverlayFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- FORK (feed-overlay): explicit installer build. On Windows, run:
         dotnet msbuild KikitanTranslator.WinForms.csproj -t:PackInstaller -p:Configuration=Release
         (or let .github/workflows/winforms-installer.yml do it).
         Requires the `vpk` dotnet tool (dotnet tool install -g vpk).
         Produces Setup.exe + release assets under ./releases.
         Self-contained publish: no .NET runtime prerequisite on the target PC. -->
    <Target Name="PackInstaller">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/KikitanTranslator.WinForms.csproj&quot; -c Release -r win-x64 --self-contained true -o &quot;$(MSBuildProjectDirectory)/publish/app&quot;" />
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../KikitanTranslator.Overlay/KikitanTranslator.Overlay.csproj&quot; -c Release -r win-x64 --self-contained true -o &quot;$(MSBuildProjectDirectory)/publish/app&quot;" />
        <Exec Command="vpk pack -u KikitanTranslator.WinForms -v $(Version) -p &quot;$(MSBuildProjectDirectory)/publish/app&quot; -e KikitanTranslator.WinForms.exe -i &quot;$(MSBuildProjectDirectory)/../KikitanTranslator.Photino/Resources/wwwroot/kikitan_logo.ico&quot; --packTitle &quot;Kikitan Translator&quot; -o &quot;$(MSBuildProjectDirectory)/Releases&quot;" />
    </Target>

</Project>
